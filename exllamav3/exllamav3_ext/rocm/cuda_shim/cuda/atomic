// Shim: `#include <cuda/atomic>` (libcu++) -> HIP atomics.
//
// exllamav3 uses a deliberately narrow slice: cuda::atomic_ref<int,
// cuda::thread_scope_device> with .load(), .store() and .fetch_add(), for the
// grid-wide barrier in ptx.cuh and the MoE scheduler in exl3_moe_kernel.cuh.
// ROCm ships no libcu++, so provide just that slice over __hip_atomic_*.
//
// Only what those call sites need is implemented. Anything else should fail to
// compile rather than silently pick a weaker ordering -- hence no catch-all
// default and no seq_cst fallback.
#pragma once

#include <hip/hip_runtime.h>

namespace cuda {

// libcu++ spells these as enumerators of `thread_scope`, used as the second
// template argument of atomic_ref.
enum thread_scope {
    thread_scope_system = __HIP_MEMORY_SCOPE_SYSTEM,
    thread_scope_device = __HIP_MEMORY_SCOPE_AGENT,
    thread_scope_block  = __HIP_MEMORY_SCOPE_WORKGROUP,
    thread_scope_thread = __HIP_MEMORY_SCOPE_SINGLETHREAD,
};

// Map libcu++ memory orders onto the clang __ATOMIC_* constants that the
// __hip_atomic_* builtins take.
inline constexpr int memory_order_relaxed = __ATOMIC_RELAXED;
inline constexpr int memory_order_consume = __ATOMIC_CONSUME;
inline constexpr int memory_order_acquire = __ATOMIC_ACQUIRE;
inline constexpr int memory_order_release = __ATOMIC_RELEASE;
inline constexpr int memory_order_acq_rel = __ATOMIC_ACQ_REL;
inline constexpr int memory_order_seq_cst = __ATOMIC_SEQ_CST;

template <typename T, thread_scope Scope = thread_scope_device>
class atomic_ref
{
public:
    __device__ explicit atomic_ref(T& ref) : ptr_(&ref) {}

    __device__ T load(int order = memory_order_seq_cst) const
    {
        return __hip_atomic_load(ptr_, order, Scope);
    }

    __device__ void store(T desired, int order = memory_order_seq_cst) const
    {
        __hip_atomic_store(ptr_, desired, order, Scope);
    }

    __device__ T fetch_add(T arg, int order = memory_order_seq_cst) const
    {
        return __hip_atomic_fetch_add(ptr_, arg, order, Scope);
    }

    __device__ T fetch_sub(T arg, int order = memory_order_seq_cst) const
    {
        return __hip_atomic_fetch_sub(ptr_, arg, order, Scope);
    }

    __device__ T exchange(T desired, int order = memory_order_seq_cst) const
    {
        return __hip_atomic_exchange(ptr_, desired, order, Scope);
    }

private:
    T* ptr_;
};

}  // namespace cuda
